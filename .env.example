# Copy this to .env on a VPS and edit the public URL.

# Expose the Node web UI outside the server.
PROMPTLITE_NODE_HOST=0.0.0.0
PROMPTLITE_NODE_PORT=1234

# Keep the Python backend private. The Node UI proxies API calls to it.
PROMPTLITE_PYTHON_HOST=127.0.0.1
PROMPTLITE_PYTHON_PORT=7861
PROMPTLITE_PYTHON_BACKEND_URL=http://127.0.0.1:7861

# Optional, but useful for logs and backend docs.
# PROMPTLITE_PUBLIC_URL=http://YOUR_SERVER_IP:1234

# Optional: Hugging Face token for gated models, higher rate limits, and faster downloads.
# Create a token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Optional: disable the Diffusers safety checker that can replace images with black frames.
PROMPTLITE_DISABLE_SAFETY_CHECKER=true

# Optional: remove duplicate .bin/.fp16 weight files after model downloads.
PROMPTLITE_PRUNE_REDUNDANT_MODEL_FILES=true

# Optional: hide/block GPU-VRAM-heavy recommendations such as FLUX, SDXL, Kandinsky, and Wuerstchen.
PROMPTLITE_CPU_ONLY_MODELS=true

# Optional: use all detected CPU threads and enable CUDA TF32 optimizations where available.
PROMPTLITE_DEFAULT_PERFORMANCE_PROFILE=full_power
